# Long random string used to sign CMS logins. Required in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Leave empty to store content in data/cms.db (SQLite). Use a Postgres URL (e.g. Neon) in production.
DATABASE_URL=
# On Vercel: create a Blob store and paste its token so image uploads are kept.
BLOB_READ_WRITE_TOKEN=
# Optional: the site address (e.g. https://abdulmomen.com) so the RSS feed has full links. On Vercel the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Chat page: answers visitors with Claude. Without it, the chat shows the offline text set in the CMS.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
CHAT_MODEL=
