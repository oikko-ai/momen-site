# Long random string used to sign CMS logins. Required in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Leave empty to store content in data/cms.db (SQLite). Use a Postgres URL (e.g. Neon) in production.
DATABASE_URL=
# On Vercel: create a Blob store and paste its token so image uploads are kept.
BLOB_READ_WRITE_TOKEN=
